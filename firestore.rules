rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidSchemeCategory(category) {
      return category in [
        'INCOME_SUPPORT',
        'EQUIPMENT_SUBSIDY',
        'CROP_INSURANCE',
        'SOLAR_IRRIGATION',
        'CREDIT_LOAN',
        'WOMEN_FARMER'
      ];
    }

    function isValidTargetGender(gender) {
      return gender in ['ALL', 'FEMALE', 'MALE'];
    }

    function isValidScheme(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
             data.shortName is string && data.shortName.size() >= 1 && data.shortName.size() <= 40 &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 140 &&
             data.category is string && isValidSchemeCategory(data.category) &&
             data.benefitSummary is string && data.benefitSummary.size() >= 1 && data.benefitSummary.size() <= 240 &&
             data.fundingSponsor is string && data.fundingSponsor.size() >= 1 && data.fundingSponsor.size() <= 120 &&
             data.eligibleStates is list && data.eligibleStates.size() >= 1 && data.eligibleStates.size() <= 40 && data.eligibleStates[0] is string &&
             data.maxLandAcres is number && data.maxLandAcres >= 0 && data.maxLandAcres <= 10000 &&
             data.maxAnnualIncomeInr is int && data.maxAnnualIncomeInr >= 0 && data.maxAnnualIncomeInr <= 100000000 &&
             data.targetGender is string && isValidTargetGender(data.targetGender) &&
             data.requiredDocuments is list && data.requiredDocuments.size() >= 1 && data.requiredDocuments.size() <= 20 && data.requiredDocuments[0] is string &&
             data.officialSourceUrl is string && data.officialSourceUrl.size() >= 8 && data.officialSourceUrl.size() <= 300 && data.officialSourceUrl.matches('^https://.*') &&
             data.lastVerifiedDate is string && data.lastVerifiedDate.size() >= 1 && data.lastVerifiedDate.size() <= 40 &&
             data.verifiedByOrg is string && data.verifiedByOrg.size() >= 1 && data.verifiedByOrg.size() <= 100 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCheckLog(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.stateRegion is string && data.stateRegion.size() >= 1 && data.stateRegion.size() <= 60 &&
             data.inputMode in ['PLAIN_LANGUAGE', 'VOICE_DIALECT', 'DEMO_PROFILE'] &&
             data.matchedCount is int && data.matchedCount >= 0 && data.matchedCount <= 100 &&
             data.checklistDownloaded is bool &&
             data.partnerChannel is string && data.partnerChannel.size() >= 1 && data.partnerChannel.size() <= 80 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPartnerFunding(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.organizationName is string && data.organizationName.size() >= 1 && data.organizationName.size() <= 120 &&
             data.partnerType in ['STATE_AGRI_DEPT', 'CSR_FUND', 'SEED_FERTILIZER_COOP', 'KVK_CENTER'] &&
             data.regionCovered is string && data.regionCovered.size() >= 1 && data.regionCovered.size() <= 100 &&
             data.farmersSponsoredTarget is int && data.farmersSponsoredTarget >= 0 && data.farmersSponsoredTarget <= 10000000 &&
             data.fundingContributionLabel is string && data.fundingContributionLabel.size() >= 1 && data.fundingContributionLabel.size() <= 100 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);

      // User-scoped editable scheme rules store
      match /schemes/{schemeId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(schemeId);

        allow create: if isOwner(userId) &&
                         isValidId(schemeId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'shortName', 'department', 'category',
                           'benefitSummary', 'fundingSponsor', 'eligibleStates',
                           'maxLandAcres', 'maxAnnualIncomeInr', 'targetGender',
                           'requiredDocuments', 'officialSourceUrl',
                           'lastVerifiedDate', 'verifiedByOrg', 'active',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'shortName', 'department', 'category',
                           'benefitSummary', 'fundingSponsor', 'eligibleStates',
                           'maxLandAcres', 'maxAnnualIncomeInr', 'targetGender',
                           'requiredDocuments', 'officialSourceUrl',
                           'lastVerifiedDate', 'verifiedByOrg', 'active',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidScheme(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(schemeId) &&
                         isValidScheme(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action 1: Full rule edit by B2G/KVK admin
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'shortName', 'department', 'category',
                             'benefitSummary', 'fundingSponsor', 'eligibleStates',
                             'maxLandAcres', 'maxAnnualIncomeInr', 'targetGender',
                             'requiredDocuments', 'officialSourceUrl',
                             'lastVerifiedDate', 'verifiedByOrg', 'active', 'updatedAt'
                           ]) ||
                           // Action 2: Quick verify timestamp refresh
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'lastVerifiedDate', 'verifiedByOrg', 'updatedAt'
                           ]) ||
                           // Action 3: Toggle active status
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'active', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(schemeId);
      }

      // Zero-PII eligibility check & checklist impact logs
      match /check_logs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(logId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll([
                           'userId', 'stateRegion', 'inputMode', 'matchedCount',
                           'checklistDownloaded', 'partnerChannel', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'stateRegion', 'inputMode', 'matchedCount',
                           'checklistDownloaded', 'partnerChannel', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCheckLog(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidCheckLog(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'checklistDownloaded', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // Institutional B2B/B2G sponsors funding free farmer access
      match /partner_funding/{partnerId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(partnerId);

        allow create: if isOwner(userId) &&
                         isValidId(partnerId) &&
                         incoming().keys().hasAll([
                           'userId', 'organizationName', 'partnerType', 'regionCovered',
                           'farmersSponsoredTarget', 'fundingContributionLabel',
                           'active', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'organizationName', 'partnerType', 'regionCovered',
                           'farmersSponsoredTarget', 'fundingContributionLabel',
                           'active', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidPartnerFunding(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(partnerId) &&
                         isValidPartnerFunding(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'organizationName', 'partnerType', 'regionCovered',
                           'farmersSponsoredTarget', 'fundingContributionLabel',
                           'active', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(partnerId);
      }
    }
  }
}
